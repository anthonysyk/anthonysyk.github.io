---
import Base from '../../layouts/Base.astro';
import PostItem from '../../components/PostItem.astro';
import { getPosts, groupBy } from '../../lib/site';

const posts = await getPosts();
const tags = [...groupBy(posts, 'tags')]
  .filter(([, t]) => t.posts.length > 1)
  .sort((a, b) => b[1].posts.length - a[1].posts.length);
---

<Base title="Articles" description="Retours d'expérience sur Scala, Go, big data, cloud et architecture.">
  <h1 class="page-title">Articles</h1>
  <p class="mt-3 max-w-2xl leading-relaxed">
    Retours d'expérience sur Scala, Go, la data et le cloud. {posts.length} articles —{' '}
    <a class="link" href="/search/">rechercher</a>.
  </p>
  <div class="mt-6 flex flex-wrap gap-2">
    {
      tags.map(([slug, t]) => (
        <a class="tag" href={`/tags/${slug}/`}>
          {t.label}
          <span class="ml-1 text-zinc-400">{t.posts.length}</span>
        </a>
      ))
    }
  </div>
  <ul class="mt-10 divide-y divide-zinc-200 border-t border-zinc-200 dark:divide-zinc-800 dark:border-zinc-800">
    {posts.map((p) => <PostItem post={p} />)}
  </ul>
</Base>
