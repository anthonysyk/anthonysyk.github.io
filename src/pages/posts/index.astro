---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts, groupBy } from '../../lib/site';

const posts = await getPosts();
const tags = [...groupBy(posts, 'tags')]
  .filter(([, t]) => t.posts.length > 1)
  .sort((a, b) => b[1].posts.length - a[1].posts.length);
---

<Base title="Articles" description="Retours d'expérience sur Scala, Go, big data, cloud et architecture.">
  <p class="eyebrow">Blog</p>
  <h1 class="page-title mt-3">Notes &amp; <span class="grad">retours d'expérience</span></h1>
  <p class="mt-5 max-w-2xl text-lg leading-relaxed">
    Scala, Go, data et cloud : ce que j'ai appris en production. {posts.length} articles —{' '}
    <a class="link" href="/search/">rechercher</a>.
  </p>
  <div class="mt-8 flex flex-wrap gap-2">
    {
      tags.map(([slug, t]) => (
        <a class="tag" href={`/tags/${slug}/`}>
          #{t.label}
          <span class="text-line-strong">{t.posts.length}</span>
        </a>
      ))
    }
  </div>
  <div class="mt-12"><PostList posts={posts} /></div>
</Base>
