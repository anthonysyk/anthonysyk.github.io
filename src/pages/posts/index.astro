---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts, groupBy } from '../../lib/site';

const posts = await getPosts();
const tags = [...groupBy(posts, 'tags')].sort((a, b) => b[1].posts.length - a[1].posts.length);
---

<Base title="Articles" description="Retours d'expérience sur Scala, Go, big data, cloud et architecture.">
  <h1 class="text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white">Articles</h1>
  <p class="mt-2 text-slate-600 dark:text-slate-400">{posts.length} articles — <a class="text-[color:var(--color-accent)]" href="/search/">rechercher</a></p>
  <div class="mt-5 flex flex-wrap gap-2">{tags.map(([slug, t]) => <a class="chip" href={`/tags/${slug}/`}>#{t.label} ({t.posts.length})</a>)}</div>
  <div class="mt-10 grid gap-5 sm:grid-cols-2">{posts.map((p) => <PostCard post={p} />)}</div>
</Base>
