---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts, groupBy } from '../../lib/site';

export async function getStaticPaths() {
  const groups = groupBy(await getPosts(), 'tags');
  return [...groups].map(([slug, g]) => ({ params: { slug }, props: g }));
}
const { label, posts } = Astro.props;
---

<Base title={`Tag : ${label}`} noindex>
  <a href="/posts/" class="text-sm text-slate-500 hover:text-[color:var(--color-accent)]">← Articles</a>
  <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white">#{label}</h1>
  <div class="mt-8 grid gap-5 sm:grid-cols-2">{posts.map((p) => <PostCard post={p} />)}</div>
</Base>
