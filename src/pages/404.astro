---
import Base from '../layouts/Base.astro';
---

<Base title="Page introuvable" noindex>
  <div class="py-24 text-center">
    <p class="gradient-text text-8xl font-extrabold">404</p>
    <p class="mt-4 text-slate-500">Cette page n'existe pas (ou plus).</p>
    <a href="/" class="mt-8 inline-block rounded-full bg-[color:var(--color-accent)] px-6 py-2.5 text-white">Retour à l'accueil</a>
  </div>
</Base>
