---
import Base from '../layouts/Base.astro';
---

<Base title="Page introuvable" noindex>
  <div class="py-20">
    <p class="eyebrow">Erreur 404</p>
    <h1 class="page-title mt-3">Page <span class="serif">introuvable</span></h1>
