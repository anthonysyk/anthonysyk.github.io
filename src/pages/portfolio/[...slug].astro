---
import { getCollection, render } from 'astro:content';
import Article from '../../layouts/Article.astro';

export async function getStaticPaths() {
  const items = await getCollection('portfolio', (p) => !p.data.draft && !p.data.hidden);
  return items.map((project) => ({ params: { slug: project.id }, props: { project } }));
}
const { project } = Astro.props;
const { Content } = await render(project);
---

<Article title={project.data.title} description={project.data.summary} image={project.data.image} date={project.data.date} article={false} back={{ href: '/portfolio/', label: 'Portfolio' }}>
  <Content />
</Article>
