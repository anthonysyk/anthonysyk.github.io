---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects } from '../../lib/site';
const projects = await getProjects();
---

<Base title="Portfolio" description="Missions et projets : data engineering, architecture cloud, API et produits.">
  <h1 class="page-title">Portfolio</h1>
  <p class="mt-3 max-w-2xl leading-relaxed">
    Une sélection de missions et de projets : data engineering, architecture cloud, API et produits.
  </p>
  <div class="mt-12 grid gap-x-8 gap-y-14 sm:grid-cols-2">{projects.map((p) => <ProjectCard project={p} />)}</div>
</Base>
