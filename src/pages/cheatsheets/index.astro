---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
const items = await getCollection('cheatsheets');
---

<Base title="Cheatsheets" description="Aide-mémoire Go et GitHub.">
  <h1 class="page-title">Cheatsheets</h1>
  <p class="mt-3 max-w-2xl leading-relaxed">Aide-mémoire pratiques.</p>
  <ul class="mt-10 divide-y divide-zinc-200 border-t border-zinc-200 dark:divide-zinc-800 dark:border-zinc-800">
    {
      items.map((c) => (
        <li class="group relative py-6">
          <h2 class="font-medium text-zinc-900 transition-colors group-hover:text-[var(--accent)] dark:text-zinc-100">
            <a href={`/cheatsheets/${c.id}/`} class="after:absolute after:inset-0">
              {c.data.title}
            </a>
          </h2>
          {c.data.summary && <p class="mt-1.5 line-clamp-2 text-sm">{c.data.summary}</p>}
        </li>
      ))
    }
  </ul>
</Base>
