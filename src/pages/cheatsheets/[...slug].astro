---
import { getCollection, render } from 'astro:content';
import Article from '../../layouts/Article.astro';

export async function getStaticPaths() {
  const items = await getCollection('cheatsheets');
  return items.map((c) => ({ params: { slug: c.id }, props: { c } }));
}
const { c } = Astro.props;
const { Content, headings } = await render(c);
---

<Article title={c.data.title} description={c.data.summary} headings={headings} article={false} back={{ href: '/cheatsheets/', label: 'Cheatsheets' }}>
  <Content />
</Article>
