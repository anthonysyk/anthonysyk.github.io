---
import Base from '../layouts/Base.astro';
---

<Base title="Recherche" description="Rechercher dans les articles et projets." noindex>
  <h1 class="page-title mb-8">Recherche</h1>
  <div id="search"></div>
  <p id="search-dev" class="hidden text-sm text-zinc-500">
    La recherche est disponible après <code>npm run build</code> puis <code>npm run preview</code>.
  </p>
  <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
  <script is:inline>
    const s = document.createElement('script');
    s.src = '/pagefind/pagefind-ui.js';
    s.onload = () => new PagefindUI({ element: '#search', showSubResults: true });
    s.onerror = () => document.getElementById('search-dev').classList.remove('hidden');
    document.head.appendChild(s);
  </script>
</Base>
