---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts, groupBy } from '../../lib/site';

export async function getStaticPaths() {
  const groups = groupBy(await getPosts(), 'categories');
  return [...groups].map(([slug, g]) => ({ params: { slug }, props: g }));
}
const { label, posts } = Astro.props;
---

<Base title={`Catégorie : ${label}`} noindex>
  <a href="/posts/" class="inline-flex items-center gap-1.5 text-sm text-muted transition-colors hover:text-fg"
    ><span aria-hidden="true">←</span> Articles</a
  >
  <p class="eyebrow mt-8">Catégorie</p>
  <h1 class="page-title mt-3 capitalize">{label}</h1>
  <div class="mt-12"><PostList posts={posts} /></div>
</Base>
