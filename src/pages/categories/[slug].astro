---
import Base from '../../layouts/Base.astro';
import PostItem from '../../components/PostItem.astro';
import { getPosts, groupBy } from '../../lib/site';

export async function getStaticPaths() {
  const groups = groupBy(await getPosts(), 'categories');
  return [...groups].map(([slug, g]) => ({ params: { slug }, props: g }));
}
const { label, posts } = Astro.props;
---

<Base title={`Catégorie : ${label}`} noindex>
  <a href="/posts/" class="text-sm text-zinc-500 transition-colors hover:text-zinc-900 dark:hover:text-zinc-100"
    >← Articles</a
  >
  <p class="section-title mt-6">Catégorie</p>
  <h1 class="page-title mt-2">{label}</h1>
  <ul class="mt-10 divide-y divide-zinc-200 border-t border-zinc-200 dark:divide-zinc-800 dark:border-zinc-800">
    {posts.map((p) => <PostItem post={p} />)}
  </ul>
</Base>
