---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ExpertiseIcon from '../components/ExpertiseIcon.astro';
import { formatMonth, getFeaturedProject, getPosts, getProjects, SITE } from '../lib/site';

const allPosts = await getPosts();
const allProjects = await getProjects();
const featured = await getFeaturedProject();
const latest = allPosts[0];

const stats = [
  { value: `${new Date().getFullYear() - SITE.since}+ ans`, label: "d'expérience" },
  { value: allProjects.length, label: 'projets' },
  { value: allPosts.length, label: 'articles publiés' },
];

const stack = [
  'Golang',
  'AWS',
  'Kubernetes',
  'Terraform',
  'Redis',
  'MongoDB',
  'Elasticsearch',
  'Kafka',
  'Claude',
  'React/TypeScript',
  'Datadog',
];

const expertise = [
  {
    icon: 'data',
    title: 'Data engineering',
    text: 'Je conçois des pipelines batch et streaming, des datalakes et des ETL à grande échelle.',
  },
  {
    icon: 'api',
    title: 'Backend & API',
    text: 'Je développe des services typés, testés et performants, pensés pour durer.',
  },
  {
    icon: 'cloud',
    title: 'Cloud & DevOps',
    text: "J'accompagne les migrations cloud, le scaling et la maîtrise des coûts d'infra.",
  },
  {
    icon: 'product',
    title: 'Côté produit',
    text: 'Du besoin métier à la mise en production, en équipe et sans dette technique.',
  },
];
---

<Base bare>
  <!-- Hero : toujours sombre -->
  <section class="dark relative isolate overflow-hidden bg-bg px-6 pt-36 pb-16 text-text sm:pt-44">
    <div class="glow -top-40 right-[-5%] -z-10 h-[32rem] w-[42rem] bg-lavender/20" aria-hidden="true"></div>
    <div class="glow top-60 -left-40 -z-10 h-80 w-[30rem] bg-accent/10" aria-hidden="true"></div>

    <div class="mx-auto grid max-w-6xl grid-cols-[minmax(0,1fr)] items-center gap-16 lg:grid-cols-[1fr_1.1fr]">
      <div>
        {
          SITE.available && (
            <p class="inline-flex items-center gap-2 rounded-full border border-line bg-surface/60 px-3.5 py-1.5 text-xs">
              <span class="relative flex size-2">
                <span class="absolute inline-flex size-full animate-ping rounded-full bg-[#7ee2a8] opacity-60" />
                <span class="relative inline-flex size-2 rounded-full bg-[#7ee2a8]" />
              </span>
              Disponible pour de nouvelles missions
            </p>
          )
        }
        <h1 class="display mt-8 text-[3.25rem] sm:text-7xl lg:text-[5.25rem]">
          Salut, moi c'est <span class="grad">Anthony.</span>
        </h1>
        <p class="mt-8 max-w-xl text-lg leading-relaxed sm:text-xl">
          Développeur <span class="text-fg">Scala &amp; Go</span> depuis {SITE.since}. Je conçois des plateformes data,
          des API et des infrastructures cloud fiables, avec du code simple et maintenable.
        </p>
        <div class="mt-10 flex flex-wrap gap-3">
          <a href={SITE.social.Email} class="btn btn-lg btn-primary">Me contacter</a>
          <a href="/portfolio/" class="btn btn-lg btn-secondary">Voir mes projets</a>
        </div>
        <dl class="mt-12 grid max-w-lg grid-cols-3 gap-3">
          {
            stats.map((s) => (
              <div class="panel flex flex-col items-center px-2 py-5 text-center">
                <dd class="text-xl font-medium text-fg">{s.value}</dd>
                <dt class="mt-1 text-xs text-muted">{s.label}</dt>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="relative lg:pl-6">
        <div class="glow inset-10 -z-10 bg-lavender/35" aria-hidden="true"></div>
        <a
          href={`/portfolio/${featured.id}/`}
          class="group block overflow-hidden rounded-[28px] border border-white/10 bg-surface p-2 shadow-[0_40px_120px_-30px_rgba(142,155,245,0.45)] transition hover:-translate-y-1"
        >
          <span class="flex items-center justify-between gap-4 px-3 py-2.5 text-xs">
            <span><span class="eyebrow mr-2 text-[10px]">À la une</span><span class="text-fg">{featured.data.title}</span></span>
            <span class="text-muted">{featured.data.date.getUTCFullYear()}</span>
          </span>
          {
            featured.data.image && (
              <img
                src={featured.data.image}
                alt={`Aperçu du projet ${featured.data.title}`}
                class="aspect-[16/10] w-full rounded-[20px] object-cover object-top"
              />
            )
          }
        </a>
        <a
          href={`/posts/${latest.id}/`}
          class="panel absolute -bottom-10 -left-6 hidden w-64 p-4 backdrop-blur transition hover:-translate-y-0.5 sm:block"
        >
          <span class="eyebrow text-[10px]">Dernier article</span>
          <span class="mt-1.5 block text-sm leading-snug text-fg">{latest.data.title}</span>
          <span class="mt-2 block text-xs text-muted">{formatMonth(latest.data.date)}</span>
        </a>
      </div>
    </div>

    <div class="mx-auto mt-24 max-w-6xl border-t border-line pt-10 text-center">
      <p class="text-xs tracking-[0.1em] text-muted uppercase">Ma stack au quotidien</p>
      <ul class="mt-6 flex flex-wrap items-center justify-center gap-x-10 gap-y-3 text-xl font-medium tracking-tight text-white/30">
        {stack.map((s) => <li>{s}</li>)}
      </ul>
    </div>
  </section>

  <!-- Expertise : bande noire -->
  <section class="dark bg-black px-6 py-24 text-text" aria-labelledby="expertise">
    <p id="expertise" class="eyebrow text-center">Ce que je fais</p>
    <div class="mx-auto mt-14 grid max-w-6xl gap-12 sm:grid-cols-2 lg:grid-cols-4">
      {
        expertise.map((e) => (
          <div class="flex flex-col items-center text-center">
            <ExpertiseIcon name={e.icon} id={`g-${e.icon}`} />
            <h3 class="mt-6 text-xl text-fg">{e.title}</h3>
            <p class="mt-2 max-w-[16rem] text-sm leading-relaxed">{e.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Projets & articles : suivent le thème clair/sombre -->
  <div class="px-6 py-24 sm:py-32">
    <div class="mx-auto max-w-6xl">
      <section aria-labelledby="projects">
        <div class="section-head">
          <div>
            <p class="eyebrow">Portfolio</p>
            <h2 id="projects" class="section-title">Projets <span class="grad">sélectionnés</span></h2>
          </div>
          <a href="/portfolio/" class="btn btn-secondary">Tout voir →</a>
        </div>
        <div class="grid gap-6 sm:grid-cols-2">{allProjects.filter((p) => p.id !== featured.id).slice(0, 4).map((p) => <ProjectCard project={p} />)}</div>
      </section>

      <section class="mt-28 sm:mt-36" aria-labelledby="posts">
        <div class="section-head">
          <div>
            <p class="eyebrow">Blog</p>
            <h2 id="posts" class="section-title">Articles <span class="grad">récents</span></h2>
          </div>
          <a href="/posts/" class="btn btn-secondary">Tous les articles →</a>
        </div>
        <PostList posts={allPosts.slice(0, 5)} />
      </section>
    </div>
  </div>

  <!-- Contact -->
  <section class="dark relative isolate overflow-hidden bg-bg px-6 py-28 text-center text-text">
    <div class="glow top-1/2 left-1/2 -z-10 h-72 w-[40rem] -translate-x-1/2 -translate-y-1/2 bg-lavender/20" aria-hidden="true"></div>
    <img
      src="/general/avatar.webp"
      alt=""
      width="80"
      height="80"
      class="mx-auto size-20 rounded-full border border-white/10 object-cover"
      loading="lazy"
    />
    <h2 class="display mt-8 text-4xl sm:text-6xl">Restons en <span class="grad">contact.</span></h2>
    <p class="mx-auto mt-5 max-w-md text-lg">
      Une question sur un article, un retour d'expérience à partager ou juste envie d'échanger ? Écris-moi.
    </p>
    <div class="mt-10 flex flex-wrap justify-center gap-3">
      <a href={SITE.social.Email} class="btn btn-lg btn-primary">Écrire un message</a>
      <a href={SITE.social.LinkedIn} rel="me noopener" class="btn btn-lg btn-secondary">LinkedIn</a>
    </div>
  </section>
</Base>
