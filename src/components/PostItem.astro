---
import type { CollectionEntry } from 'astro:content';
import { formatMonth, readingTime } from '../lib/site';
interface Props {
  post: CollectionEntry<'posts'>;
}
const { post } = Astro.props;
---

<li class="group relative grid gap-1 py-6 sm:grid-cols-[9rem_1fr] sm:gap-8">
  <time datetime={post.data.date.toISOString()} class="pt-0.5 text-sm tabular-nums text-zinc-500">
    {formatMonth(post.data.date)}
  </time>
  <div>
    <h3 class="font-medium text-zinc-900 transition-colors group-hover:text-[var(--accent)] dark:text-zinc-100">
      <a href={`/posts/${post.id}/`} class="after:absolute after:inset-0">{post.data.title}</a>
    </h3>
    {post.data.summary && <p class="mt-1.5 line-clamp-2 text-sm leading-relaxed">{post.data.summary}</p>}
    <p class="mt-2 text-xs text-zinc-500">
      {readingTime(post.body)} min de lecture{post.data.tags.length > 0 && ` · ${post.data.tags.slice(0, 3).join(', ')}`}
    </p>
  </div>
</li>
