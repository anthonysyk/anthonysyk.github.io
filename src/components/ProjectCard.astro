---
import type { CollectionEntry } from 'astro:content';
interface Props { project: CollectionEntry<'portfolio'> }
const { project } = Astro.props;
---

<a href={`/portfolio/${project.id}/`} class="card group">
  <div class="aspect-[16/9] overflow-hidden bg-gradient-to-br from-[#7c5cff]/30 to-[#22d3ee]/20">
    {project.data.image && <img src={project.data.image} alt="" loading="lazy" class="size-full object-cover object-top transition duration-500 group-hover:scale-105" />}
  </div>
  <div class="p-5">
    <h3 class="font-semibold text-slate-900 transition group-hover:text-[color:var(--color-accent)] dark:text-white">{project.data.title}</h3>
    <p class="mt-2 line-clamp-3 text-sm text-slate-600 dark:text-slate-400">{project.data.summary}</p>
  </div>
</a>
