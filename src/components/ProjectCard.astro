---
import type { CollectionEntry } from 'astro:content';
interface Props {
  project: CollectionEntry<'portfolio'>;
}
const { project } = Astro.props;
---

<a
  href={`/portfolio/${project.id}/`}
  class="panel group flex flex-col overflow-hidden transition duration-300 hover:-translate-y-1"
>
  <div class="aspect-[16/9] overflow-hidden bg-[#141415]">
    {
      project.data.image ? (
        <img
          src={project.data.image}
          alt=""
          loading="lazy"
          class="size-full object-cover object-top transition-transform duration-500 ease-out group-hover:scale-[1.03]"
        />
      ) : (
        <div class="relative grid size-full place-items-center bg-[radial-gradient(ellipse_at_30%_20%,rgba(142,155,245,0.25),transparent_60%),radial-gradient(ellipse_at_80%_90%,rgba(241,192,134,0.2),transparent_55%)]">
          <span class="display grad text-5xl">{project.data.title.split(' - ')[0]}</span>
        </div>
      )
    }
  </div>
  <div class="flex flex-1 flex-col p-6">
    <div class="flex items-baseline justify-between gap-4">
      <h3 class="text-lg font-medium tracking-tight text-fg">{project.data.title}</h3>
      <span class="shrink-0 text-xs text-muted">{project.data.date.getUTCFullYear()}</span>
    </div>
    <p class="mt-2 line-clamp-2 text-sm leading-relaxed">{project.data.summary}</p>
  </div>
</a>
