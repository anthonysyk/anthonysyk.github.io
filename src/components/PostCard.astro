---
import type { CollectionEntry } from 'astro:content';
import { formatDate, readingTime } from '../lib/site';
interface Props { post: CollectionEntry<'posts'> }
const { post } = Astro.props;
---

<a href={`/posts/${post.id}/`} class="card group p-5">
  <div class="mb-2 flex items-center gap-2 text-xs text-slate-500">
    <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
    <span aria-hidden="true">·</span>
    <span>{readingTime(post.body)} min</span>
  </div>
  <h3 class="text-lg font-semibold leading-snug text-slate-900 transition group-hover:text-[color:var(--color-accent)] dark:text-white">{post.data.title}</h3>
  {post.data.summary && <p class="mt-2 line-clamp-3 text-sm text-slate-600 dark:text-slate-400">{post.data.summary}</p>}
  {post.data.tags.length > 0 && (
    <div class="mt-4 flex flex-wrap gap-1.5">{post.data.tags.slice(0, 4).map((t) => <span class="chip">{t}</span>)}</div>
  )}
</a>
