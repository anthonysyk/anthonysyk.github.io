---
import { SITE } from '../lib/site';
---

<footer class="mt-32 border-t border-zinc-200 dark:border-zinc-800">
  <div class="mx-auto flex max-w-5xl flex-col gap-4 px-6 py-8 text-sm text-zinc-500 sm:flex-row sm:items-center sm:justify-between">
    <p>© {new Date().getFullYear()} {SITE.author} · {SITE.name}</p>
    <ul class="flex gap-5">
      {
        Object.entries(SITE.social).map(([k, v]) => (
          <li>
            <a href={v} rel="me noopener" class="transition-colors hover:text-zinc-900 dark:hover:text-zinc-100">
              {k}
            </a>
          </li>
        ))
      }
      <li><a href="/rss.xml" class="transition-colors hover:text-zinc-900 dark:hover:text-zinc-100">RSS</a></li>
    </ul>
  </div>
</footer>
