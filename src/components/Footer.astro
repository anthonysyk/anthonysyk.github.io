---
import { SITE } from '../lib/site';
import Logo from './Logo.astro';
---

<footer class="dark bg-[#0c0c0d] text-text">
  <div class="mx-auto flex max-w-6xl flex-col gap-8 px-6 py-12 sm:flex-row sm:items-center sm:justify-between">
    <div class="flex flex-col gap-3">
      <Logo />
      <p class="text-xs text-muted">Développeur Backend Go &amp; Cloud · © {new Date().getFullYear()}</p>
    </div>
    <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
      {
        Object.entries(SITE.social).map(([k, v]) => (
          <li>
            <a href={v} rel="me noopener" class="text-muted transition-colors hover:text-fg">
              {k}
            </a>
          </li>
        ))
      }
      <li><a href="/rss.xml" class="text-muted transition-colors hover:text-fg">RSS</a></li>
    </ul>
  </div>
</footer>
