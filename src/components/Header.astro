---
import { nav } from '../lib/site';
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
const path = Astro.url.pathname;
---

<header class="sticky top-0 z-30 border-b border-line bg-bg/80 backdrop-blur-xl">
  <div class="mx-auto flex max-w-5xl flex-wrap items-center gap-x-6 gap-y-3 px-6 py-3.5">
    <Logo />
    <nav aria-label="Navigation principale" class="order-last -ml-3 flex w-full items-center text-sm sm:order-none sm:ml-auto sm:w-auto">
      {
        nav.map((n) => (
          <a
            href={n.href}
            aria-current={path.startsWith(n.href) ? 'page' : undefined}
            class="rounded-full px-3 py-1.5 text-muted transition-colors hover:text-fg aria-[current=page]:text-fg"
          >
            {n.label}
          </a>
        ))
      }
    </nav>
    <div class="-mr-2 ml-auto flex items-center gap-0.5 sm:ml-0">
      <a
        href="/search/"
        aria-label="Rechercher"
        class="grid size-8 place-items-center rounded-full text-muted transition-colors hover:bg-surface-2 hover:text-fg"
      >
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"
          ><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg
        >
      </a>
      <ThemeToggle />
    </div>
  </div>
</header>
