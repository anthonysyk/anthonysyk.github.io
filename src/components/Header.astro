---
import { nav, SITE } from '../lib/site';
import ThemeToggle from './ThemeToggle.astro';
const path = Astro.url.pathname;
---

<header class="sticky top-0 z-30 border-b border-slate-200/70 bg-slate-50/80 backdrop-blur-lg dark:border-white/10 dark:bg-[#0b0d14]/80">
  <div class="mx-auto flex h-16 max-w-5xl items-center justify-between px-5">
    <a href="/" class="text-lg font-bold tracking-tight"><span class="gradient-text">{SITE.name}</span></a>
    <nav aria-label="Navigation principale" class="flex items-center gap-1 text-sm sm:gap-2">
      {
        nav.map((n) => (
          <a
            href={n.href}
            aria-current={path.startsWith(n.href) ? 'page' : undefined}
            class="rounded-full px-3 py-1.5 transition hover:text-[color:var(--color-accent)] aria-[current=page]:bg-[color:var(--color-accent)]/10 aria-[current=page]:text-[color:var(--color-accent)]"
          >
            {n.label}
          </a>
        ))
      }
      <a href="/search/" aria-label="Rechercher" class="grid size-9 place-items-center rounded-full hover:text-[color:var(--color-accent)]">
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
      </a>
      <ThemeToggle />
    </nav>
  </div>
</header>
