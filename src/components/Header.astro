---
import { nav } from '../lib/site';
import Logo from './Logo.astro';
const path = Astro.url.pathname;
---

<header class="fixed inset-x-0 top-0 z-40 px-3 pt-3 sm:px-4">
  <div
    class="mx-auto flex max-w-6xl items-center justify-between gap-2 rounded-2xl border border-white/[0.07] bg-[#18181a]/95 py-2 pr-2 pl-3 shadow-[0_8px_30px_-12px_rgba(0,0,0,0.5)] backdrop-blur-xl sm:pl-4"
  >
    <span class="max-sm:[&_span]:hidden"><Logo /></span>
    <nav aria-label="Navigation principale" class="flex items-center text-[13px] sm:text-sm">
      {
        nav.map((n) => (
          <a
            href={n.href}
            aria-current={path.startsWith(n.href) ? 'page' : undefined}
            class="rounded-lg px-2 py-2 text-white/60 transition-colors hover:bg-white/5 hover:text-white aria-[current=page]:text-white sm:px-3"
          >
            {n.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
