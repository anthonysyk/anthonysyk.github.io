---
import Base from './Base.astro';
import { formatDate, readingTime, slugify } from '../lib/site';
import type { MarkdownHeading } from 'astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  date?: Date;
  tags?: string[];
  categories?: string[];
  body?: string;
  headings?: MarkdownHeading[];
  back?: { href: string; label: string };
  article?: boolean;
}
const { title, description, image, date, tags = [], categories = [], body, headings = [], back, article = true } = Astro.props;
const toc = headings.filter((h) => h.depth === 2);
---

<Base title={title} description={description} image={image} type={article ? 'article' : 'website'} date={date}>
  <article data-pagefind-body class="mx-auto max-w-3xl">
    {back && <a href={back.href} class="text-sm text-slate-500 hover:text-[color:var(--color-accent)]">← {back.label}</a>}
    <header class="mb-10 mt-4">
      <h1 data-pagefind-meta="title" class="text-3xl font-extrabold leading-tight tracking-tight text-slate-900 sm:text-4xl dark:text-white">{title}</h1>
      <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-slate-500">
        {date && <time datetime={date.toISOString()}>{formatDate(date)}</time>}
        {body && <span>· {readingTime(body)} min de lecture</span>}
        {categories.map((c) => <a class="chip" href={`/categories/${slugify(c)}/`}>{c}</a>)}
        {tags.map((t) => <a class="chip" href={`/tags/${slugify(t)}/`}>#{t}</a>)}
      </div>
    </header>
    {toc.length > 2 && (
      <details class="mb-8 rounded-xl border border-slate-200 p-4 text-sm dark:border-white/10">
        <summary class="cursor-pointer font-medium">Sommaire</summary>
        <ul class="mt-3 space-y-1.5">{toc.map((h) => <li><a class="hover:text-[color:var(--color-accent)]" href={`#${h.slug}`}>{h.text}</a></li>)}</ul>
      </details>
    )}
    <div class="prose prose-slate dark:prose-invert prose-headings:tracking-tight">
      <slot />
    </div>
  </article>
</Base>
