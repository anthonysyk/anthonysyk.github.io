---
import Base from './Base.astro';
import { formatDate, readingTime, slugify } from '../lib/site';
import type { MarkdownHeading } from 'astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  date?: Date;
  tags?: string[];
  categories?: string[];
  body?: string;
  headings?: MarkdownHeading[];
  back?: { href: string; label: string };
  article?: boolean;
}
const {
  title,
  description,
  image,
  date,
  tags = [],
  categories = [],
  body,
  headings = [],
  back,
  article = true,
} = Astro.props;
const toc = headings.filter((h) => h.depth === 2);
---

<Base title={title} description={description} image={image} type={article ? 'article' : 'website'} date={date}>
  <article data-pagefind-body class="mx-auto max-w-[44rem]">
    {
      back && (
        <a href={back.href} class="inline-flex items-center gap-1.5 text-sm text-muted transition-colors hover:text-fg">
          <span aria-hidden="true">←</span> {back.label}
        </a>
      )
    }
    <header class="mt-8 mb-12">
      {
        categories.length > 0 && (
          <p class="eyebrow mb-4 flex gap-3">
            {categories.map((c) => (
              <a href={`/categories/${slugify(c)}/`} class="hover:text-fg">
                {c}
              </a>
            ))}
          </p>
        )
      }
      <h1 data-pagefind-meta="title" class="page-title leading-[1.1]">{title}</h1>
      {description && article && <p class="mt-5 text-lg leading-relaxed text-muted">{description}</p>}
      {
        (date || body) && (
          <p class="mt-6 flex items-center gap-3 font-mono text-xs text-muted">
            {date && <time datetime={date.toISOString()}>{formatDate(date)}</time>}
            {date && body && <span class="text-line-strong">/</span>}
            {body && <span>{readingTime(body)} min de lecture</span>}
          </p>
        )
      }
    </header>
    {
      toc.length > 2 && (
        <nav aria-label="Sommaire" class="panel mb-12 px-6 py-5 text-sm">
          <p class="eyebrow mb-3">Sommaire</p>
          <ol class="grid gap-x-6 gap-y-1.5 sm:grid-cols-2">
            {toc.map((h, i) => (
              <li class="flex gap-3">
                <span class="font-mono text-xs leading-5 text-muted">{String(i + 1).padStart(2, '0')}</span>
                <a class="text-text transition-colors hover:text-fg" href={`#${h.slug}`}>
                  {h.text}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }
    <div class="prose">
      <slot />
    </div>
    {
      tags.length > 0 && (
        <footer class="mt-16 flex flex-wrap gap-2 border-t border-line pt-6">
          {tags.map((t) => (
            <a class="tag" href={`/tags/${slugify(t)}/`}>
              #{t}
            </a>
          ))}
        </footer>
      )
    }
  </article>
</Base>
