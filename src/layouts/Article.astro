---
import Base from './Base.astro';
import { formatDate, readingTime, slugify } from '../lib/site';
import type { MarkdownHeading } from 'astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  date?: Date;
  tags?: string[];
  categories?: string[];
  body?: string;
  headings?: MarkdownHeading[];
  back?: { href: string; label: string };
  article?: boolean;
}
const {
  title,
  description,
  image,
  date,
  tags = [],
  categories = [],
  body,
  headings = [],
  back,
  article = true,
} = Astro.props;
const toc = headings.filter((h) => h.depth === 2);
const meta = [
  date && formatDate(date),
  body && `${readingTime(body)} min de lecture`,
].filter(Boolean);
---

<Base title={title} description={description} image={image} type={article ? 'article' : 'website'} date={date}>
  <article data-pagefind-body class="mx-auto max-w-[44rem]">
    {
      back && (
        <a href={back.href} class="text-sm text-zinc-500 transition-colors hover:text-zinc-900 dark:hover:text-zinc-100">
          ← {back.label}
        </a>
      )
    }
    <header class="mb-10 mt-6 border-b border-zinc-200 pb-8 dark:border-zinc-800">
      {
        categories.length > 0 && (
          <p class="mb-3 text-xs font-semibold uppercase tracking-[0.12em] text-zinc-500">
            {categories.map((c, i) => (
              <>
                {i > 0 && ' · '}
                <a href={`/categories/${slugify(c)}/`} class="hover:text-zinc-900 dark:hover:text-zinc-100">
                  {c}
                </a>
              </>
            ))}
          </p>
        )
      }
      <h1 data-pagefind-meta="title" class="page-title leading-tight">{title}</h1>
      {meta.length > 0 && <p class="mt-4 text-sm text-zinc-500">{meta.join(' · ')}</p>}
    </header>
    {
      toc.length > 2 && (
        <nav aria-label="Sommaire" class="mb-10 rounded-lg border border-zinc-200 px-5 py-4 text-sm dark:border-zinc-800">
          <p class="section-title mb-3">Sommaire</p>
          <ol class="space-y-1.5">
            {toc.map((h) => (
              <li>
                <a class="transition-colors hover:text-zinc-900 dark:hover:text-zinc-100" href={`#${h.slug}`}>
                  {h.text}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }
    <div class="prose prose-zinc dark:prose-invert prose-headings:text-zinc-900 dark:prose-headings:text-zinc-100">
      <slot />
    </div>
    {
      tags.length > 0 && (
        <footer class="mt-12 flex flex-wrap gap-2 border-t border-zinc-200 pt-6 dark:border-zinc-800">
          {tags.map((t) => (
            <a class="tag" href={`/tags/${slugify(t)}/`}>
              {t}
            </a>
          ))}
        </footer>
      )
    }
  </article>
</Base>
